define endian=little;
define alignment=2;

define space code     type=ram_space      size=4 wordsize=2 default;
define space data     type=ram_space      size=2 wordsize=2;
define space register type=register_space size=4;

# 40-bit accumulators (kept as 64-bit to make decompilation output simpler)
define register offset=0x0000 size=8 [
    a0 a1 b0 b1
];

define register offset=0x0000 size=2 [
    a0l a0h _ _
    a1l a1h _ _
    b0l b0h _ _
    b1l b1h _ _
];

define register offset=0x0000 size=1 [
    _ _ _ _ a0e _ _ _
	_ _ _ _ a1e _ _ _
	_ _ _ _ b0e _ _ _
	_ _ _ _ b1e _ _ _
];

# 16-bit address registers
define register offset=0x0100 size=2 [
    r0 r1 r2 r3 r4 r5 r6 r7
];

# 18-bit + 4-bit PC
# The extra 4 bits represent the PRPAGE register
define register offset=0x0200 size=4 [
    pc
];

# 16-bit stack pointer
define register offset=0x0300 size=2 [
    sp
];

# 16-bit multiplication operands
define register offset=0x0400 size=2 [
    x0 x1 y0 y1
];

# 33-bit product registers (kept as 64-bit to make decompilation output simpler)
define register offset=0x0500 size=8 [
    p0 p1
];

define register offset=0x0500 size=2 [
	p0l p0h _ _
	p1l p1h _ _
];

define register offset=0x0500 size=1 [
    _ _ _ _ p0e _ _ _
	_ _ _ _ p1e _ _ _
];

# 8-bit page register
define register offset=0x0600 size=1 [
    page
];

# 1-bit flags
define register offset=0x0700 size=1 [
    fz fm fn fv fe fc0 fc1 flm fvl fr
];

# Misc 16-bit registers
define register offset=0x0800 size=2 [
    sv
    repc lc0 lc1 lc2 lc3
    stepi stepj modi modj stepi0 stepj0
    mixp
    ps0 ps1
];

# 16-bit page scratchpad registers
# These aren't actually real registers on the Teak - they exist to aid decompilation
# The C compiler treats page=0 as a scratchpad rather than a global space
define register offset=0x2000 size=2 [
	pg00 pg01 pg02 pg03 pg04 pg05 pg06 pg07
	pg08 pg09 pg0A pg0B pg0C pg0D pg0E pg0F
	pg10 pg11 pg12 pg13 pg14 pg15 pg16 pg17
	pg18 pg19 pg1A pg1B pg1C pg1D pg1E pg1F
	pg20 pg21 pg22 pg23 pg24 pg25 pg26 pg27
	pg28 pg29 pg2A pg2B pg2C pg2D pg2E pg2F
	pg30 pg31 pg32 pg33 pg34 pg35 pg36 pg37
	pg38 pg39 pg3A pg3B pg3C pg3D pg3E pg3F
	pg40 pg41 pg42 pg43 pg44 pg45 pg46 pg47
	pg48 pg49 pg4A pg4B pg4C pg4D pg4E pg4F
	pg50 pg51 pg52 pg53 pg54 pg55 pg56 pg57
	pg58 pg59 pg5A pg5B pg5C pg5D pg5E pg5F
	pg60 pg61 pg62 pg63 pg64 pg65 pg66 pg67
	pg68 pg69 pg6A pg6B pg6C pg6D pg6E pg6F
	pg70 pg71 pg72 pg73 pg74 pg75 pg76 pg77
	pg78 pg79 pg7A pg7B pg7C pg7D pg7E pg7F
	pg80 pg81 pg82 pg83 pg84 pg85 pg86 pg87
	pg88 pg89 pg8A pg8B pg8C pg8D pg8E pg8F
	pg90 pg91 pg92 pg93 pg94 pg95 pg96 pg97
	pg98 pg99 pg9A pg9B pg9C pg9D pg9E pg9F
	pgA0 pgA1 pgA2 pgA3 pgA4 pgA5 pgA6 pgA7
	pgA8 pgA9 pgAA pgAB pgAC pgAD pgAE pgAF
	pgB0 pgB1 pgB2 pgB3 pgB4 pgB5 pgB6 pgB7
	pgB8 pgB9 pgBA pgBB pgBC pgBD pgBE pgBF
	pgC0 pgC1 pgC2 pgC3 pgC4 pgC5 pgC6 pgC7
	pgC8 pgC9 pgCA pgCB pgCC pgCD pgCE pgCF
	pgD0 pgD1 pgD2 pgD3 pgD4 pgD5 pgD6 pgD7
	pgD8 pgD9 pgDA pgDB pgDC pgDD pgDE pgDF
	pgE0 pgE1 pgE2 pgE3 pgE4 pgE5 pgE6 pgE7
	pgE8 pgE9 pgEA pgEB pgEC pgED pgEE pgEF
	pgF0 pgF1 pgF2 pgF3 pgF4 pgF5 pgF6 pgF7
	pgF8 pgF9 pgFA pgFB pgFC pgFD pgFE pgFF
];

# Temporary staging register for Bus16-type operations
define register offset=0xF000 size=2 [
	bus16
];

# Context registers
define register offset=0x10000 size=16 [
	contextreg
];

# Tokens
define token instr(16)
    # Fields used for generic instruction decoding
    instr_0_0=(0, 0)
    
    instr_0_1=(0, 1)
    instr_1_1=(1, 1)
    
    instr_0_2=(0, 2)
    instr_1_2=(1, 2)
    instr_2_2=(2, 2)
    
    instr_0_3=(0, 3)
    instr_3_3=(3, 3)
    
    instr_0_4=(0, 4)
    instr_0_4s=(0, 4) signed
    instr_1_4=(1, 4)
    instr_2_4=(2, 4)
    instr_4_4=(4, 4)
    
    instr_0_5s=(0, 5) signed
    instr_2_5=(2, 5)
    instr_4_5=(4, 5)
    instr_5_5=(5, 5)
    
    instr_0_6s=(0, 6) signed
    instr_5_6=(5, 6)
    instr_6_6=(6, 6)
    
    instr_0_7=(0, 7)
    instr_0_7s=(0, 7) signed
    instr_2_7=(2, 7)
    instr_3_7=(3, 7)
    instr_4_7=(4, 7)
    instr_5_7=(5, 7)
    instr_7_7=(7, 7)
    
    instr_5_8=(5, 8)
    instr_7_8=(7, 8)
    instr_8_8=(8, 8)
    
    instr_1_9=(1, 9)
    instr_2_9=(2, 9)
    instr_3_9=(3, 9)
    instr_5_9=(5, 9)
    instr_7_9=(7, 9)
    instr_8_9=(8, 9)
    instr_9_9=(9, 9)
    
    instr_4_10s=(4, 10) signed
    instr_8_10=(8, 10)
    
    instr_4_11=(4, 11)
    instr_7_11=(7, 11)
    instr_8_11=(8, 11)
    
    instr_12_12=(12, 12)
    
     instr_word=(0, 15)
     instr_1_15=(1, 15)
     instr_2_15=(2, 15)
     instr_3_15=(3, 15)
     instr_4_15=(4, 15)
     instr_5_15=(5, 15)
     instr_6_15=(6, 15)
     instr_7_15=(7, 15)
     instr_8_15=(8, 15)
     instr_9_15=(9, 15)
    instr_10_15=(10, 15)
    instr_11_15=(11, 15)
    instr_12_15=(12, 15)
    instr_13_15=(13, 15)
    
    # Fields attached to operands

    ## PageReg
    PageReg=(0, 7)
    
    ## Reg
    Reg0=(0, 4)
    Reg5=(5, 9)
    
    ## Ax
     Ax0=(0, 0)
     Ax1=(1, 1)
     Ax3=(3, 3)
     Ax4=(4, 4)
     Ax5=(5, 5)
     Ax6=(6, 6)
     Ax8=(8, 8)
    Ax10=(10, 10)
    Ax11=(11, 11)
    Ax12=(12, 12)
    
    ## Axl
     Axl0=(0, 0)
     Axl4=(4, 4)
     Axl5=(5, 5)
     Axl8=(8, 8)
    Axl12=(12, 12)
    
    ## Axh
     Axh4=(4, 4)
     Axh6=(6, 6)
     Axh8=(8, 8)
     Axh9=(9, 9)
    Axh12=(12, 12)
    
    ## Bx
     Bx0=(0, 0)
     Bx1=(1, 1)
     Bx2=(2, 2)
     Bx3=(3, 3)
     Bx4=(4, 4)
     Bx5=(5, 5)
     Bx8=(8, 8)
    Bx10=(10, 10)
    Bx12=(12, 12)
    
    ## Bxl doesn't seem to be used in the Teak
    
    ## Bxh
    Bxh2=(2, 2)
    Bxh5=(5, 5)
    Bxh8=(8, 8)
    
    ## Ab
     Ab0=(0, 1)
     Ab2=(2, 3)
     Ab3=(3, 4)
     Ab4=(4, 5)
     Ab5=(5, 6)
     Ab6=(6, 7)
     Ab7=(7, 8)
     Ab8=(8, 9)
    Ab10=(10, 11)
    Ab11=(11, 12)
    
    ## Abl
     Abl0=(0, 1)
     Abl3=(3, 4)
    Abl10=(10, 11)
    
    ## Abh
    Abh2=(2, 3)
    Abh4=(4, 5)
    Abh8=(8, 9)
    
    ## Abe
    Abe0=(0, 1)
    Abe1=(1, 2)
    
    ## Ablh
    Ablh9=(9, 11)
    Ablh10=(10, 12)
    
    ## Px
    Px0=(0, 0)
    Px1=(1, 1)
    
    ## RnOld
     RnOld9=(9, 11)
    RnOld10=(10, 12)
    
    ## Rn
    Rn0=(0, 2)
    
    ## R45
    R45_2=(2, 2)
    
    ## R0123
    R0123_0=(0, 1)
    R0123_5=(5, 6)
    
    ## StepMode
    StepMode0=(0, 1)
    StepMode3=(3, 4)
    StepMode5=(5, 6)
    StepMode7=(7, 8)
    
    ## SttMod
    SttMod0=(0, 2)
    SttMod8=(8, 10)
    
    ## ArArp
    ArArp0=(0, 2)
    ArArp8=(8, 10)
    
    ## ArArpSttMod
    ArArpSttMod0=(0, 3)
    ArArpSttMod8=(8, 11)
    
    ## ArRn1
    ArRn1_1=(1, 1)
    ArRn1_3=(3, 3)
    ArRn1_4=(4, 4)
    
    ## ArRn2
    ArRn2_2=(2, 3)
    ArRn2_8=(8, 9)
    ArRn2_10=(10, 11)
    
    ## ArStep1
    ArStep1_0=(0, 0)
    ArStep1_2=(2, 2)
    ArStep1_3=(3, 3)
    
    ## ArStep2
    ArStep2_0=(0, 1)
    ArStep2_2=(2, 3)
    ArStep2_5=(5, 6)
    
    ## ArpRn1
    ArpRn1_2=(2, 2)
    ArpRn1_5=(5, 5)
    
    ## ArpRn2
    ArpRn2_4=(4, 5)
    ArpRn2_10=(10, 11)
    
    ## ArpStep1
    ArpStep1_0=(0, 0)
    ArpStep1_1=(1, 1)
    ArpStep1_3=(3, 3)
    ArpStep1_4=(4, 4)
    
    ## ArpStep2
    ArpStep2_0=(0, 1)
    ArpStep2_2=(2, 3)
    ArpStep2_5=(5, 6)
    
    # Instruction fields
    Alm=(9, 12)
    Alu0=(0, 2)
    Alu9=(9, 11)
    Alb0=(0, 2)
    Alb9=(9, 11)
    Alb10=(10, 12)
    Moda4=(4, 7)
    Moda3=(4, 6)
    Mul2=(9, 10)
    Mul3_1=(1, 3)
    Mul3_8=(8, 10)
;

define token instr_exp(16)
    instr_expword=(0, 15)
;

# Context
define context contextreg
    regname_src=(0, 4) noflow
    regname_dst=(5, 9) noflow
    stepmode=(10, 12) noflow
	stepmode2=(13, 15) noflow
	page_scratch=(16, 16)
	rep=(17, 17) noflow
	lpmark=(18, 18) noflow
	lpmark2=(19, 19) noflow
	bcn=(20, 22)
	ctxname=(23, 26) noflow
	rn=(27, 29) noflow
	rn2=(30, 32) noflow
	
	pname=(33, 33) noflow
	pname2=(34, 34) noflow
	
	arrn=(35, 36) noflow
	arstep=(37, 38) noflow
	arrn2=(39, 40) noflow
	arstep2=(41, 42) noflow
	
	sumbase=(43, 44) noflow
	p0_sub=(45, 45) noflow
	p0_a=(46, 46) noflow
	p1_sub=(47, 47) noflow
	p1_a=(48, 48) noflow
	sumacc=(49, 50) noflow
	
	x0_uns=(51, 51) noflow
	y0_uns=(52, 52) noflow
	x1_uns=(53, 53) noflow
	y1_uns=(54, 54) noflow
	
	bkrepaddr=(96, 127) noflow
;

