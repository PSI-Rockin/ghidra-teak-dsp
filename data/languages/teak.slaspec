# Custom pcodes
define pcodeop Sat;

define pcodeop IntrDisable;
define pcodeop IntrEnable;
define pcodeop CntxStore;
define pcodeop CntxRestore;

define pcodeop BankCfgi;
define pcodeop BankR4;
define pcodeop BankR1;
define pcodeop BankR0;
define pcodeop BankR7;
define pcodeop BankCfgj;

define pcodeop Exp;

# Macros
macro SetAccFlag(value)
{
	local tmp:8 = zext(value);
	fz = tmp == 0;
	fm = tmp s< 0;
	local tmp32:4 = trunc(tmp);
	local tmp32_s:8 = sext(tmp32);
	fe = tmp != tmp32_s;
	
	# TODO: fn
}

macro SetAccAndFlag(reg, value)
{
	SetAccFlag(value);
	
	reg = value;
}

macro SatAndSetAccAndFlag(reg, value)
{
	SetAccFlag(value);
	
	# TODO: saturation
	reg = value;
}

macro PushWord(x)
{
	local mysave:2 = x;
	sp = sp - 1;
	*[data]:2 sp = mysave;
}

macro PushDouble(x)
{
	local mysave:4 = x;
	sp = sp - 2;
	*[data]:4 sp = mysave;
}

macro PopWord(x)
{
	x = *[data]:2 sp;
	sp = sp + 1;
}

macro PopDouble(x)
{
	x = *[data]:4 sp;
	sp = sp + 2;
}

macro Add40(result, a, b)
{
	result = a + b;
	fc0 = carry(a, b);
	fv = scarry(a, b);
	fvl = fvl | fv;
}

macro Sub40(result, a, b)
{
	result = a - b;
	fc0 = a < b;
	fv = sborrow(a, b);
	fvl = fvl | fv;
}

# TODO: Shift operations do saturation but in a weird way compared to everything else
# TODO: Arithmetic variations (s == 0)
macro ShiftLeft40(acc_dst, val, shift)
{
	local result:8 = zext(val) << shift;
	fc0 = ((result >> 40) & 0x1) != 0;
	SetAccAndFlag(acc_dst, result:8);
}

macro ShiftRight40(acc_dst, val, shift)
{
	local result:8 = zext(val);
	fc0 = ((result >> (shift - 1)) & 0x1) != 0;
	result = result >> shift;
	SetAccAndFlag(acc_dst, result:8);
}

# Used when the shift value is not an immediate
macro ShiftGen40(acc_dst, val, shift)
{
	if (shift s< 0) goto <shift_right>;
	ShiftLeft40(acc_dst, val, shift);
	goto <done>;
<shift_right>
	ShiftRight40(acc_dst, val, -shift);
<done>
}

macro HwMultiplySS(prod, x, y)
{
	local tmp:8 = sext(x);
	local tmp2:8 = sext(y);
	
	prod = tmp * tmp2;
}

macro HwMultiplySU(prod, x, y)
{
	local tmp:8 = sext(x);
	local tmp2:8 = zext(y);
	
	prod = tmp * tmp2;
}

macro HwMultiplyUS(prod, x, y)
{
	local tmp:8 = zext(x);
	local tmp2:8 = sext(y);
	
	prod = tmp * tmp2;
}

macro HwMultiplyUU(prod, x, y)
{
	local tmp:8 = zext(x);
	local tmp2:8 = zext(y);
	
	prod = tmp * tmp2;
}

macro BkrepLoopStart(lc_src, index)
{
	local tmp:2 = zext(lc_src) + 1;
	if (index == 1) goto <bcn1>;
	if (index == 2) goto <bcn2>;
	if (index == 3) goto <bcn3>;
	lc3 = tmp; goto <done>;
<bcn1>
	lc0 = tmp; goto <done>;
<bcn2>
	lc1 = tmp; goto <done>;
<bcn3>
	lc2 = tmp;
<done>
}

macro LoopCheck(inst, counter)
{
	build inst;
	if (counter == 0) goto inst_next;
	counter = counter - 1;
}

macro BkrepLoopCheck(inst, counter, start)
{
	build inst;
	counter = counter - 1;
	if (counter != 0) goto start;
}

macro MaxMinImpl40(acc, counter_acc, addr, cond)
{
	fm = cond;
	
	if (!fm) goto <done>;
	mixp = addr;
	acc = counter_acc;
<done>
}

macro MaxGe40(acc, counter_acc, addr)
{
	local cond:1 = counter_acc s>= acc;
	MaxMinImpl40(acc, counter_acc, addr, cond);
}

macro MaxGt40(acc, counter_acc, addr)
{
	local cond:1 = counter_acc s> acc;
	MaxMinImpl40(acc, counter_acc, addr, cond);
}

macro MinLe40(acc, counter_acc, addr)
{
	local cond:1 = counter_acc s<= acc;
	MaxMinImpl40(acc, counter_acc, addr, cond);
}

macro MinLt40(acc, counter_acc, addr)
{
	local cond:1 = counter_acc s< acc;
	MaxMinImpl40(acc, counter_acc, addr, cond);
}

macro ProductToBus40(out, prod, shift_ctrl)
{
	local tmp:8 = prod;
	
	if (shift_ctrl == 1) goto <shift_right>;
	if (shift_ctrl < 2) goto <done>;
	tmp = tmp << (shift_ctrl - 1);
	goto <done>;
<shift_right>
	tmp = tmp s>> 1;
<done>
    out = tmp;
}

macro Swap(s0, s1, d0, d1)
{
	local tmp:8 = s0;
	local tmp2:8 = s1;
	SatAndSetAccAndFlag(d0, tmp);
	SatAndSetAccAndFlag(d1, tmp2);
}

# Common subconstructors
Cond:       is instr_0_3=0 {}
Cond: ".eq" is instr_0_3=1
{
	if (fz != 1) goto inst_next;
}
Cond: ".ne" is instr_0_3=2
{
	if (fz != 0) goto inst_next;
}
Cond: ".gt" is instr_0_3=3
{
	if (fz != 0 || fm != 0) goto inst_next;
}
Cond: ".ge" is instr_0_3=4
{
	if (fm != 0) goto inst_next;
}
Cond: ".lt" is instr_0_3=5
{
	if (fm != 1) goto inst_next;
}
Cond: ".le" is instr_0_3=6
{
	if (fm != 1 && fz != 1) goto inst_next;
}
Cond: ".nn" is instr_0_3=7
{
	if (fn != 0) goto inst_next;
}
Cond: ".c"  is instr_0_3=8
{
	if (fc0 != 1) goto inst_next;
}
Cond: ".v"  is instr_0_3=9
{
	if (fv != 1) goto inst_next;
}
Cond: ".e"  is instr_0_3=10
{
	if (fe != 1) goto inst_next;
}
Cond: ".l"  is instr_0_3=11
{
	if (flm != 1 && fvl != 1) goto inst_next;
}
Cond: ".nr" is instr_0_3=12
{
	if (fr != 0) goto inst_next;
}
Cond: ".ni" is instr_0_3=13 unimpl
Cond: ".i0" is instr_0_3=14 unimpl
Cond: ".i1" is instr_0_3=15 unimpl

# Operand subconstructors
Address16: reloc is instr_expword [ reloc = instr_expword + (inst_next & 0x30000); ]
{ export *[code]:4 reloc; }

Address18: reloc is instr_4_5 ; instr_expword [ reloc = instr_expword | (instr_4_5 << 16); ]
{ export *[code]:4 reloc; }

RelAddr7: reloc is instr_4_10s [ reloc = inst_next + instr_4_10s; ]
{ export *[code]:4 reloc; }

BkrepAddr16: reloc is instr_expword [ reloc = (inst_start & 0x30000) + instr_expword + 1; ] { export *[code]:4 reloc; }
BkrepAddr16M1: reloc is instr_expword [ reloc = (inst_start & 0x30000) + instr_expword + 0; ] { export *[code]:4 reloc; }
BkrepAddr16M2: reloc is instr_expword [ reloc = (inst_start & 0x30000) + instr_expword - 1; ] { export *[code]:4 reloc; }

BkrepAddr18: reloc is instr_5_6 ; instr_expword [ reloc = (instr_expword + 1) | (instr_5_6 << 16); ]
{ export *[code]:4 reloc; }
BkrepAddr18M1: reloc is instr_5_6 ; instr_expword [ reloc = (instr_expword + 0) | (instr_5_6 << 16); ]
{ export *[code]:4 reloc; }
BkrepAddr18M2: reloc is instr_5_6 ; instr_expword [ reloc = (instr_expword - 1) | (instr_5_6 << 16); ]
{ export *[code]:4 reloc; }

BkrepAddr18_2: reloc is instr_0_1 ; instr_expword [ reloc = (instr_expword + 1) | (instr_0_1 << 16); ]
{ export *[code]:4 reloc; }
BkrepAddr18_2M1: reloc is instr_0_1 ; instr_expword [ reloc = (instr_expword + 0) | (instr_0_1 << 16); ]
{ export *[code]:4 reloc; }
BkrepAddr18_2M2: reloc is instr_0_1 ; instr_expword [ reloc = (instr_expword - 1) | (instr_0_1 << 16); ]
{ export *[code]:4 reloc; }

BkrepStart: reloc is bkrepaddr [ reloc = bkrepaddr + 0; ] { export *[code]:4 reloc; }

Imm2: instr_0_1 is instr_0_1
{
	local tmp:2 = instr_0_1;
	export tmp;
}

Imm8: instr_0_7 is instr_0_7
{
	local tmp:1 = instr_0_7;
	export tmp;
}

Imm4_0: instr_0_3 is instr_0_3 { local tmp:2 = instr_0_3; export tmp; }
Imm4_8: instr_8_11 is instr_8_11 { local tmp:2 = instr_8_11; export tmp; }

Imm16: instr_expword is instr_expword
{
	local tmp:2 = instr_expword;
	export tmp;
}

MemImm8: "["page:Imm8"]" is page_scratch=1 & page & Imm8 & PageReg
{
	export PageReg;
}

MemImm8: "["page:Imm8"]" is page_scratch=0 & page & Imm8
{
	local tmp:2 = zext(Imm8);
	local tmp2:2 = zext(page);
	tmp = tmp | (tmp2 << 8);
	export *[data]:2 tmp;
}

MemImm16: "["reloc"]" is instr_expword
[
	reloc = instr_expword + 0;
]
{
	export *[data]:2 reloc;
}

Imm5s: instr_0_4s is instr_0_4s
{
	local tmp:2 = instr_0_4s;
	export tmp;
}

Imm6s: instr_0_5s is instr_0_5s
{
	local tmp:2 = instr_0_5s;
	export tmp;
}

Imm7s: instr_0_6s is instr_0_6s
{
	local tmp:2 = instr_0_6s;
	export tmp;
}

Imm8s: instr_0_7s is instr_0_7s
{
	local tmp:2 = instr_0_7s;
	export tmp;
}

MemR7Imm16: "["r7+Imm16"]" is r7 & Imm16
{
	local tmp:2 = r7 + Imm16;
	export *[data]:2 tmp;
}

MemR7Imm7s: "["r7+Imm7s"]" is r7 & Imm7s
{
	local tmp:2 = r7+Imm7s;
	export *[data]:2 tmp;
}

Bcn: val is epsilon [ val = bcn; ] { export *[const]:1 val; }
Lc: "lc" is bcn=0 { export lc0; }
Lc: "lc" is bcn=1 { export lc0; }
Lc: "lc" is bcn=2 { export lc1; }
Lc: "lc" is bcn=3 { export lc2; }
Lc: "lc" is epsilon { export lc3; }
LcNext: "lc" is bcn=0 { export lc0; }
LcNext: "lc" is bcn=1 { export lc1; }
LcNext: "lc" is bcn=2 { export lc2; }
LcNext: "lc" is epsilon { export lc3; }

Banke0: "cfgi" is instr_0_0=1 { BankCfgi(); }
Banke0: is instr_0_0=0 {}

Banke1: Banke0, r4 is instr_1_1=1 & Banke0 & r4 { build Banke0; BankR4(); }
Banke1: r4 is instr_1_1=1 & instr_0_0=0 & r4 { BankR4(); }
Banke1: Banke0 is instr_1_1=0 & Banke0 { }

Banke2: Banke1, r1 is instr_2_2=1 & Banke1 & r1 { build Banke1; BankR1(); }
Banke2: r1 is instr_2_2=1 & instr_0_1=0 & r1 { BankR1(); }
Banke2: Banke1 is instr_2_2=0 & Banke1 { }

Banke3: Banke2, r0 is instr_3_3=1 & Banke2 & r0 { build Banke2; BankR0(); }
Banke3: r0 is instr_3_3=1 & instr_0_2=0 & r0 { BankR0(); }
Banke3: Banke2 is instr_3_3=0 & Banke2 { }

Banke4: Banke3, r7 is instr_4_4=1 & Banke3 & r7 { build Banke3; BankR7(); }
Banke4: r7 is instr_4_4=1 & instr_0_3=0 & r7 { BankR7(); }
Banke4: Banke3 is instr_4_4=0 & Banke3 { }

Banke: Banke4, "cfgj" is instr_5_5=1 & Banke4 { build Banke4; BankCfgj(); }
Banke: "cfgj" is instr_5_5=1 & instr_0_4=0 { BankCfgj(); }
Banke: Banke4 is instr_5_5=0 & Banke4 { }

PToBus40: p0 is pname=0 & p0 { local tmp:8; ProductToBus40(tmp, p0, ps0); export tmp; }
PToBus40: p1 is pname=1 & p1 { local tmp:8; ProductToBus40(tmp, p1, ps1); export tmp; }
P2ToBus40: p0 is pname2=0 & p0 { local tmp:8; ProductToBus40(tmp, p0, ps0); export tmp; }
P2ToBus40: p1 is pname2=1 & p1 { local tmp:8; ProductToBus40(tmp, p1, ps1); export tmp; }

# This include needs to be before everything else!
@include "operand_acc.sinc"

@include "operand_ctx.sinc"
@include "operand_register.sinc"
@include "operand_rnstep.sinc"

# Instructions
@include "instr_alm_alu.sinc"
@include "instr_alb.sinc"
@include "instr_mac.sinc"
@include "instr_moda.sinc"
@include "instr_mov.sinc"

ins:"nop" is instr_word=0
{
	
}

with ins: instr_4_15=0x498
{
	:"swap" a0, b0 is instr_0_3=0x0 & a0 & b0 { Swap(a0, b0, b0, a0); }
	:"swap" a0, b1 is instr_0_3=0x1 & a0 & b1 { Swap(a0, b1, b1, a0); }
	:"swap" a1, b0 is instr_0_3=0x2 & a1 & b0 { Swap(a1, b0, b0, a1); }
	:"swap" a1, b1 is instr_0_3=0x3 & a1 & b1 { Swap(a1, b1, b1, a1); }
}

ins:"or" Ab10, Ax6, Ax5 is instr_0_4=0x11 & instr_7_9=0x291>>7 & instr_12_15=0xD & Ab10 & Ax6 & Ax5
{
	SetAccAndFlag(Ax5, Ab10 | Ax6);
}

ins:"or" Ax8, Bx1, Ax0 is instr_2_7=0xA4>>2 & instr_9_15=0xD4A4>>9 & Ax8 & Bx1 & Ax0
{
	SetAccAndFlag(Ax0, Ax8 | Bx1);
}

ins:"or" Bx10, Bx1, Ax0 is instr_2_9=0x3C4>>2 & instr_11_15=0xD3C4>>11 & Bx10 & Bx1 & Ax0
{
	SetAccAndFlag(Ax0, Bx1 | Bx10);
}

ins:"add" Ab10, Bx0 is instr_1_9=0x2DA>>1 & instr_12_15=0xD & Ab10 & Bx0
{ local tmp:8; Add40(tmp, Bx0, Ab10); SatAndSetAccAndFlag(Bx0, tmp); }
ins:"add" Bx1, Ax0 is instr_2_15=0x5DF0>>2 & Bx1 & Ax0
{ local tmp:8; Add40(tmp, Ax0, Bx1); SatAndSetAccAndFlag(Ax0, tmp); }
ins:"add" p1, Ax0 is instr_1_15=0xD782>>1 & p1 & Ax0 & PToBus40 [ pname=1; ]
{ local tmp:8; Add40(tmp, Ax0, PToBus40); SatAndSetAccAndFlag(Ax0, tmp); }
ins:"add" Px1, Bx0 is instr_2_15=0x5DF8>>2 & Px1 & Bx0 & PToBus40 [ pname=Px1; ]
{ local tmp:8; Add40(tmp, Bx0, PToBus40); SatAndSetAccAndFlag(Bx0, tmp); }

ins:"sub" Ab3, Bx8 is instr_0_2=0x1 & instr_5_7=0x61>>5 & instr_9_15=0x8A61>>9 & Ab3 & Bx8
{ local tmp:8; Sub40(tmp, Bx8, Ab3); SatAndSetAccAndFlag(Bx8, tmp); }
ins:"sub" Bx4, Ax3 is instr_0_2=0x1 & instr_5_15=0x8861>>5 & Bx4 & Ax3
{ local tmp:8; Sub40(tmp, Ax3, Bx4); SatAndSetAccAndFlag(Ax3, tmp); }

ins2:"bkrep" Imm8, BkrepAddr16 is instr_8_15=0x5C & Imm8 & Lc; BkrepAddr16 & BkrepAddr16M1 & BkrepAddr16M2
[
	bkrepaddr = inst_start + 2; lpmark = 1; lpmark2 = 1;
	bcn = bcn + 1; globalset(bkrepaddr, bcn);
	globalset(BkrepAddr16M1, bkrepaddr); globalset(BkrepAddr16M1, lpmark);
	globalset(BkrepAddr16M2, bkrepaddr); globalset(BkrepAddr16M2, lpmark2);
] { Lc = zext(Imm8); }

ins2:"bkrep" RegSrc, BkrepAddr18 is (instr_7_15=0x5D00>>7 & RegSrc & Reg0 & Lc) ... & BkrepAddr18 & BkrepAddr18M1 & BkrepAddr18M2
[
	regname_src = Reg0;
	bkrepaddr = inst_start + 2; lpmark = 1; lpmark2 = 1;
	bcn = bcn + 1; globalset(bkrepaddr, bcn);
	globalset(BkrepAddr18M1, bkrepaddr); globalset(BkrepAddr18M1, lpmark);
	globalset(BkrepAddr18M2, bkrepaddr); globalset(BkrepAddr18M2, lpmark2);
]
{ Lc = RegSrc; }

ins2:"bkrep" r6, BkrepAddr18_2 is (instr_2_15=0x8FDC>>2 & r6 & Lc) ... & BkrepAddr18_2 & BkrepAddr18_2M1 & BkrepAddr18_2M2
[
	bkrepaddr = inst_start + 2; lpmark = 1; lpmark2 = 1;
	bcn = bcn + 1; globalset(bkrepaddr, bcn);
	globalset(BkrepAddr18_2M1, bkrepaddr); globalset(BkrepAddr18_2M1, lpmark);
	globalset(BkrepAddr18_2M2, bkrepaddr); globalset(BkrepAddr18_2M2, lpmark2);
] { Lc = r6; }

# TODO: Implement BKREPRST/BKREPSTO? Use custom pcodeops?
ins:"bkreprst ["sp"]" is instr_2_15=0x5F48>>2 & sp
{
	local tmp:4;
	PopDouble(tmp);
}

ins:"bkrepsto ["sp"]" is instr_3_15=0x9468>>3 & sp
{
	PushDouble(0);
}

ins:"banke" Banke is instr_6_15=0x4B80>>6 & Banke { build Banke; }

ins2:"br"^Cond Address18 is (instr_6_15=0x4180>>6 & Cond) ... & Address18
{
	build Cond;
	goto Address18;
}

ins:"brr"^Cond RelAddr7 is instr_11_15=0x5000>>11 & Cond & RelAddr7
{
	build Cond;
	goto RelAddr7;
}

ins:"break" is instr_word=0xD3C0 [ bcn = bcn - 1; globalset(inst_next, bcn); ]
{
	# All break does is adjust bcn... since that's handled in disassembly, this is a NOP
}

ins2:"call"^Cond Address18 is (instr_6_15=0x41C0>>6 & Cond) ... & Address18
{
	build Cond;
	PushDouble(inst_next);
	call Address18;
}

ins:"calla" Axl8 is instr_0_7=0x80 & instr_9_15=0xD480>>9 & Axl8
{
	PushDouble(inst_next);
	call [Axl8];
}

ins:"calla" Ax4 is instr_0_3=0x1 & instr_5_15=0xD381>>5 & Ax4
{
	PushDouble(inst_next);
	local target:4 = Ax4:4;
	call [target];
}

ins:"callr"^Cond RelAddr7 is instr_11_15=0x1000>>11 & Cond & RelAddr7
{
	build Cond;
	PushDouble(inst_next);
	call RelAddr7;
}

ins:"cntx.s" is instr_word=0xD380 { CntxStore(); }
ins:"cntx.r" is instr_word=0xD390 { CntxRestore(); }

ins:"ret"^Cond is instr_4_15=0x458 & Cond
{
	build Cond;
	local tmp:4;
	PopDouble(tmp);
	return [tmp];
}

ins:"reti"^Cond is instr_4_15=0x45C & Cond
{
	build Cond;
	IntrEnable();
	local tmp:4;
	PopDouble(tmp);
	return [tmp];
}

ins:"retic"^Cond is instr_4_15=0x45D & Cond
{
	build Cond;
	IntrEnable();
	CntxRestore();
	local tmp:4;
	PopDouble(tmp);
	return [tmp];
}

ins:"rets" Imm8 is instr_8_15=0x09 & Imm8
{
    local tmp:4;
    PopDouble(tmp);
    sp = sp + zext(Imm8);
    return [tmp];
}

ins:"load" Imm2, "ps" is instr_2_15=0x4D80>>2 & Imm2
{
	ps0 = Imm2 & 0x3;
}

ins:"load" Imm7s, stepi is instr_7_15=0xDB80>>7 & Imm7s & stepi
{
	stepi = Imm7s;
}

ins:"load" Imm7s, stepj is instr_7_15=0xDF80>>7 & Imm7s & stepj
{
	stepj = Imm7s;
}

ins:"load" Imm8, page is instr_8_15=0x04 & Imm8 & page [ page_scratch=0; globalset(inst_next, page_scratch); ]
{
	page = Imm8;
}

ins:"load" Imm4_0, "ps01" is instr_4_15=0x1 & Imm4_0
{
	ps0 = Imm4_0 & 0x3; ps1 = Imm4_0 >> 2;
}

# TODO: push/pop Px causes terrible decompilation artifacts since the firmware does these instructions in a BKREP loop
# (see https://github.com/NationalSecurityAgency/ghidra/issues/6002)
ins2:"push" Imm16 is instr_word=0x5F40; Imm16 { PushWord(Imm16); }
ins:"push" RegSrc is instr_5_15=0x5E40>>5 & Reg0 & RegSrc [ regname_src = Reg0; ] { PushWord(RegSrc); }
ins:"push" Abe1 is instr_3_15=0xD7C8>>3 & Abe1 { local tmp:2 = zext(Abe1); PushWord(tmp); }
ins:"push" ArArpSttMod0Read is instr_4_15=0xD3D & ArArpSttMod0Read { PushWord(ArArpSttMod0Read); }
ins:"push" Px1 is instr_2_15=0xD78C>>2 & Px1 {}
ins:"push" r6 is instr_0_4=0x17 & instr_6_15=0xD4D7>>6 & r6 { PushWord(r6); }
ins:"push" repc is instr_2_15=0xD7F8>>2 & repc { PushWord(repc); }
ins:"push" x0 is instr_0_4=0x14 & instr_6_15=0xD4D4>>6 & x0 { PushWord(x0); }
ins:"push" x1 is instr_0_4=0x15 & instr_6_15=0xD4D5>>6 & x1 { PushWord(x1); }
ins:"push" y1 is instr_0_4=0x16 & instr_6_15=0xD4D6>>6 & y1 { PushWord(y1); }
ins:"pusha" Ax6 is instr_2_5=0x1 & instr_7_15=0x4384>>7 & Ax6 { PushDouble(Ax6:4); }
ins:"pusha" Bx1 is instr_2_15=0xD788>>2 & Bx1 { PushDouble(Bx1:4); }

ins:"pop" RegDst is instr_5_15=0x5E60>>5 & Reg0 & RegDst [ regname_dst = Reg0; ] { PopWord(bus16); build RegDst; }
ins:"pop" ArArpSttMod8Write is instr_0_7=0xC7 & instr_12_15=0x8 & ArArpSttMod8Write { PopWord(bus16); build ArArpSttMod8Write; }
ins:"pop" Abe0 is instr_2_15=0x47B4>>2 & Abe0 { local tmp:2; PopWord(tmp); Abe0 = tmp:1; }
ins:"pop" Px0 is instr_1_15=0xD496>>1 & Px0 {}
ins:"pop" r6 is instr_1_15=0x24>>1 & r6 { PopWord(r6); }
ins:"pop" repc is instr_2_15=0xD7F0>>2 & repc { PopWord(repc); }
ins:"pop" x0 is instr_word=0xD494 & x0 { PopWord(x0); }
ins:"pop" x1 is instr_word=0xD495 & x1 { PopWord(x1); }
ins:"pop" y1 is instr_1_15=0x2 & y1 { PopWord(y1); }
ins:"popa" Ab0 is instr_2_15=0x47B0>>2 & Ab0 { local tmp:4; PopDouble(tmp); SetAccAndFlag(Ab0, sext(tmp)); }

ins:"rep" Imm8 is instr_8_15=0xC & Imm8 [rep = 1; globalset(inst_next, rep); ] { repc = zext(Imm8); }
ins:"rep" RegSrc is instr_5_15=0x0D00>>5 & RegSrc & Reg0 [ regname_src=Reg0; rep = 1; globalset(inst_next, rep); ] { repc = RegSrc; }
ins:"rep" r6 is instr_1_15=0x0002>>1 & r6 [rep = 1; globalset(inst_next, rep); ] { repc = r6; }

ins:"shfc"^Cond Ab10, Ab5 is instr_4_4=0x0 & instr_7_9=0x280>>7 & instr_12_15=0xD & Ab10 & Ab5 & Cond
{
	build Cond;
	ShiftGen40(Ab5, Ab10, sv);
}

ins:"shfi" Ab10, Ab7, Imm6s is instr_5_5=0x0 & instr_6_6=0x1 & instr_9_9=0x1 & instr_12_15=0x9 & Ab10 & Ab7 & Imm6s
{
	ShiftLeft40(Ab7, Ab10, Imm6s);
}

ins:"shfi" Ab10, Ab7, Imm6s is instr_5_5=0x1 & instr_6_6=0x1 & instr_9_9=0x1 & instr_12_15=0x9 & Ab10 & Ab7 & Imm6s
{
	ShiftRight40(Ab7, Ab10, -Imm6s);
}

ins:"tstb" MemImm8, Imm4_8 is instr_12_15=0xF & MemImm8 & Imm4_8 { fz = ((MemImm8 >> Imm4_8) & 0x1) != 0; }
ins:"tstb" MemRnStep, Imm4_8 is instr_12_15=0x9 & instr_5_7=0x1 & MemRnStep & Imm4_8 & StepMode3 [ stepmode=StepMode3; ]
{
	fz = ((MemRnStep >> Imm4_8) & 0x1) != 0;
}
ins:"tstb" RegSrc, Imm4_8 is instr_12_15=0x9 & instr_5_7=0x0 & instr_0_4!=$(OPREG_A0) & Reg0 & RegSrc & Imm4_8 [ regname_src = Reg0; ]
{
	fz = ((RegSrc >> Imm4_8) & 0x1) != 0;
}
ins:"tstb" r6, Imm4_8 is instr_12_15=0x9 & instr_0_7=0x18 & r6 & Imm4_8 { fz = ((r6 >> Imm4_8) & 0x1) != 0; }

ins:"and" Ab2, Ab0, Ax12 is instr_4_11=0x77 & instr_13_15=0x6770>>13 & Ab2 & Ab0 & Ax12 { SetAccAndFlag(Ax12, Ab2 & Ab0); }

ins:"dint" is instr_word=0x43C0 { IntrDisable(); }
ins:"eint" is instr_word=0x4380 { IntrEnable(); }

ins:"exp" Bx0 is instr_1_15=0x9460>>1 & Bx0 { sv = Exp(Bx0); }

with ins: instr_5_15=0x9440>>5
{
	:"exp" a0 is Reg0=$(OPREG_A0) & a0 { sv = Exp(a0); }
	:"exp" a1 is Reg0=$(OPREG_A1) & a1 { sv = Exp(a1); }
	:"exp" RegSrc is Reg0 & RegSrc [ regname_src=Reg0; ] { sv = Exp(RegSrc); }
}

ins:"modr" RnStep is instr_5_15=0x0080>>5 & RnStep & StepMode3 [ stepmode = StepMode3; ] { local addr:2 = RnStep; fr = addr == 0; }
ins:"modr" RnStep is instr_3_15=0x4990>>3 & RnStep [ stepmode = 4; ] { local addr:2 = RnStep; fr = addr == 0; }
ins:"modr" RnStep is instr_3_15=0x5DA0>>3 & RnStep [ stepmode = 5; ] { local addr:2 = RnStep; fr = addr == 0; }

ins:"modr" ArpStepi, ArpStepj, "ee" is instr_2_4=0x14>>2 & instr_7_9=0x294>>7 & instr_12_15=0xD &
	ArpStepi & ArpStepj & ArpStep2_0 & ArpStep2_5 & ArpRn2_10 [ arrn=ArpRn2_10; arstep=ArpStep2_0; arstep2=ArpStep2_5; ]
{
	build ArpStepi; build ArpStepj;
}

ins:"lim" Ax5, Ax4 is instr_0_3=0x0 & instr_6_15=0x49C0>>6 & Ax4 & Ax5 { SetAccAndFlag(Ax4, Sat(Ax5)); }

ins:"clrp0" is instr_word=0x5DFE { p0 = 0; }
ins:"clrp1" is instr_word=0x5DFD { p1 = 0; }
ins:"clrp" is instr_word=0x5DFF { p0 = 0; p1 = 0; }

with ins: instr_0_2=0x0 & instr_5_7=0x60>>5 & instr_9_15=0x8460>>9 [ rn = 0; ]
{
	:"max.ge" a0 "^" RnStepBase is instr_8_8=0 & a0 & StepMode3 & RnStepBase [ stepmode = StepMode3; ]
	{ local tmp:2 = RnStepBase; MaxGe40(a0, a1, tmp); }
	:"max.ge" a1 "^" RnStepBase is instr_8_8=1 & a1 & StepMode3 & RnStepBase [ stepmode = StepMode3; ]
	{ local tmp:2 = RnStepBase; MaxGe40(a1, a0, tmp); }
}

with ins: instr_0_2=0x0 & instr_5_7=0x60>>5 & instr_9_15=0x8660>>9 [ rn = 0; ]
{
	:"max.gt" a0 "^" RnStepBase is instr_8_8=0 & a0 & StepMode3 & RnStepBase [ stepmode = StepMode3; ]
	{ local tmp:2 = RnStepBase; MaxGt40(a0, a1, tmp); }
	:"max.gt" a1 "^" RnStepBase is instr_8_8=1 & a1 & StepMode3 & RnStepBase [ stepmode = StepMode3; ]
	{ local tmp:2 = RnStepBase; MaxGt40(a1, a0, tmp); }
}

with ins: instr_0_2=0x0 & instr_5_7=0x60>>5 & instr_9_15=0x8860>>9 [ rn = 0; ]
{
	:"min.le" a0 "^" RnStepBase is instr_8_8=0 & a0 & StepMode3 & RnStepBase [ stepmode = StepMode3; ]
	{ local tmp:2 = RnStepBase; MinLe40(a0, a1, tmp); }
	:"min.le" a1 "^" RnStepBase is instr_8_8=1 & a1 & StepMode3 & RnStepBase [ stepmode = StepMode3; ]
	{ local tmp:2 = RnStepBase; MinLe40(a1, a0, tmp); }
}

with ins: instr_0_2=0x0 & instr_5_7=0x60>>5 & instr_9_15=0x8A60>>9 [ rn = 0; ]
{
	:"min.lt" a0 "^" RnStepBase is instr_8_8=0 & a0 & StepMode3 & RnStepBase [ stepmode = StepMode3; ]
	{ local tmp:2 = RnStepBase; MinLt40(a0, a1, tmp); }
	:"min.lt" a1 "^" RnStepBase is instr_8_8=1 & a1 & StepMode3 & RnStepBase [ stepmode = StepMode3; ]
	{ local tmp:2 = RnStepBase; MinLt40(a1, a0, tmp); }
}

ins:"max.ge" Ax8, "["RnStepBase"]" is instr_0_2=0x0 & instr_5_7=0x60>>5 & instr_9_15=0x8060>>9 & Ax8 & StepMode3 & RnStepBase [ rn = 0; stepmode = StepMode3; ]
{ local addr:2 = RnStepBase; local tmp:8 = sext(*[data]:2 addr); MaxGe40(Ax8, tmp, addr); }
ins:"max.gt" Ax8, "["RnStepBase"]" is instr_0_2=0x0 & instr_5_7=0x60>>5 & instr_9_15=0x8260>>9 & Ax8 & StepMode3 & RnStepBase [ rn = 0; stepmode = StepMode3; ]
{ local addr:2 = RnStepBase; local tmp:8 = sext(*[data]:2 addr); MaxGt40(Ax8, tmp, addr); }
ins:"min.le" Ax3, "["RnStepBase"]" is instr_2_2=0x0 & instr_4_15=0x47A & Ax3 & StepMode0 & RnStepBase [ rn = 0; stepmode = StepMode0; ]
{ local addr:2 = RnStepBase; local tmp:8 = sext(*[data]:2 addr); MinLe40(Ax3, tmp, addr); }
ins:"min.lt" Ax3, "["RnStepBase"]" is instr_2_2=0x1 & instr_4_15=0x47A & Ax3 & StepMode0 & RnStepBase [ rn = 0; stepmode = StepMode0; ]
{ local addr:2 = RnStepBase; local tmp:8 = sext(*[data]:2 addr); MinLt40(Ax3, tmp, addr); }

ins:"cmp" Ax1, Bx0 is instr_2_15=0x4D8C>>2 & Ax1 & Bx0 { local tmp:8; Sub40(tmp, Bx0, Ax1); SetAccFlag(tmp); }
ins:"cmp" b0, b1 is instr_word=0xD483 & b0 & b1 { local tmp:8; Sub40(tmp, b1, b0); SetAccFlag(tmp); }
ins:"cmp" b1, b0 is instr_word=0xD583 & b1 & b0 { local tmp:8; Sub40(tmp, b0, b1); SetAccFlag(tmp); }
ins:"cmp" Bx10, Ax0 is instr_1_9=0x29A>>1 & instr_11_15=0xDA9A>>11 & Bx10 & Ax0 { local tmp:8; Sub40(tmp, Ax0, Bx10); SetAccFlag(tmp); }

# Merge 2-word instructions into the main table
ins:^ins2 is lpmark2=0 & ins2 { build ins2; }

# BKREP logic for 2-word instructions
ins:^ins2 is lpmark2=1 & rep=0 & ins2 & BkrepStart & LcNext [ bcn = bcn - 1; globalset(inst_next, bcn); ] { LoopCheck(ins2, LcNext); goto BkrepStart; }

# REP logic
# REP doesn't seem to work on 2-word instructions...
:^ins is lpmark=0 & rep=1 & ins { LoopCheck(ins, repc); goto inst_start; }

# BKREP logic
:^ins is lpmark=1 & rep=0 & ins & BkrepStart & LcNext [ bcn = bcn - 1; globalset(inst_next, bcn); ] { LoopCheck(ins, LcNext); goto BkrepStart; }

# Regular instruction path
:^ins is epsilon & ins { build ins; }
